rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Global safety net: deny all reads and writes unless explicitly matched
    match /{document=**} {
      allow read, write: if false;
    }

    function isValidId(id) {
      return id is string && id.size() >= 1 && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$');
    }

    function isValidUsername(name) {
      return name is string && name.size() >= 3 && name.size() <= 24 && name.matches('^[a-z0-9_]{3,24}$');
    }

    function incoming() {
      return request.resource.data;
    }

    function existing() {
      return resource.data;
    }

    function isSignedIn() {
      return request.auth != null;
    }

    function isVerifiedUser() {
      return isSignedIn() && request.auth.token.email_verified == true;
    }

    function isOwner(userId) {
      return isSignedIn() && request.auth.uid == userId;
    }

    function isValidProfile(data, userId) {
      return data.keys().hasAll([
          'id',
          'username',
          'display_name',
          'experience_level',
          'profile_completed',
          'skills',
          'interests',
          'createdAt',
          'updatedAt'
        ])
        && data.keys().hasOnly([
          'id',
          'username',
          'display_name',
          'avatar_url',
          'governorate',
          'city',
          'bio',
          'experience_level',
          'profile_completed',
          'skills',
          'interests',
          'createdAt',
          'updatedAt'
        ])
        && data.id is string
        && isValidId(data.id)
        && data.id == userId
        && data.id == request.auth.uid
        && isValidUsername(data.username)
        && data.display_name is string
        && data.display_name.size() >= 2
        && data.display_name.size() <= 80
        && (!('avatar_url' in data) || data.avatar_url == null || (data.avatar_url is string && data.avatar_url.size() <= 1000))
        && (!('governorate' in data) || data.governorate == null || (data.governorate is string && data.governorate.size() <= 80))
        && (!('city' in data) || data.city == null || (data.city is string && data.city.size() <= 80))
        && (!('bio' in data) || data.bio == null || (data.bio is string && data.bio.size() <= 300))
        && data.experience_level is string
        && data.experience_level in ['beginner', 'intermediate', 'professional', 'no_experience']
        && data.profile_completed is bool
        && data.profile_completed == true
        && data.skills is list
        && data.skills.size() <= 20
        && (data.skills.size() == 0 || (data.skills[0] is string && data.skills[0].size() >= 1 && data.skills[0].size() <= 60))
        && data.interests is list
        && data.interests.size() >= 1
        && data.interests.size() <= 20
        && data.interests[0] is string
        && data.interests[0].size() >= 1
        && data.interests[0].size() <= 60
        && data.createdAt is timestamp
        && data.updatedAt is timestamp;
    }

    function isValidUsernameReservation(data) {
      return data.keys().hasAll(['userId', 'createdAt'])
        && data.keys().hasOnly(['userId', 'createdAt'])
        && data.userId is string
        && isValidId(data.userId)
        && data.userId == request.auth.uid
        && data.createdAt is timestamp;
    }

    match /profiles/{userId} {
      allow get: if isSignedIn() && isValidId(userId) && isOwner(userId);
      allow list: if false;
      allow create: if isVerifiedUser()
        && isValidId(userId)
        && isOwner(userId)
        && isValidProfile(incoming(), userId)
        && incoming().createdAt == request.time
        && incoming().updatedAt == request.time
        && existsAfter(/databases/$(database)/documents/usernames/$(incoming().username))
        && getAfter(/databases/$(database)/documents/usernames/$(incoming().username)).data.userId == userId;
      allow update: if isVerifiedUser()
        && isValidId(userId)
        && isOwner(userId)
        && isValidProfile(incoming(), userId)
        && incoming().id == existing().id
        && incoming().createdAt == existing().createdAt
        && incoming().updatedAt == request.time
        && (
          incoming().diff(existing()).affectedKeys().hasOnly([
            'display_name',
            'avatar_url',
            'governorate',
            'city',
            'bio',
            'experience_level',
            'skills',
            'interests',
            'updatedAt'
          ])
          || (
            incoming().diff(existing()).affectedKeys().hasOnly([
              'username',
              'display_name',
              'avatar_url',
              'governorate',
              'city',
              'bio',
              'experience_level',
              'skills',
              'interests',
              'updatedAt'
            ])
            && existsAfter(/databases/$(database)/documents/usernames/$(incoming().username))
            && getAfter(/databases/$(database)/documents/usernames/$(incoming().username)).data.userId == userId
          )
        );
      allow delete: if false;
    }

    match /usernames/{username} {
      allow get: if isSignedIn() && isValidUsername(username);
      allow list: if false;
      allow create: if isVerifiedUser()
        && isValidUsername(username)
        && isValidUsernameReservation(incoming())
        && incoming().createdAt == request.time
        && !exists(/databases/$(database)/documents/usernames/$(username))
        && existsAfter(/databases/$(database)/documents/profiles/$(request.auth.uid))
        && getAfter(/databases/$(database)/documents/profiles/$(request.auth.uid)).data.username == username;
      allow update: if false;
      allow delete: if isVerifiedUser()
        && isValidUsername(username)
        && existing().userId == request.auth.uid
        && (!existsAfter(/databases/$(database)/documents/profiles/$(request.auth.uid))
          || getAfter(/databases/$(database)/documents/profiles/$(request.auth.uid)).data.username != username);
    }
  }
}
