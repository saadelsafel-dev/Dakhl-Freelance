{
  "entities": {
    "Profile": {
      "title": "Dakhl Profile",
      "description": "User profile, skills, experience level, and opportunity interests for Dakhl.",
      "type": "object",
      "properties": {
        "id": {
          "type": "string",
          "description": "Firebase Auth UID matching the document ID.",
          "minLength": 1,
          "maxLength": 128,
          "pattern": "^[a-zA-Z0-9_\\-]+$"
        },
        "username": {
          "type": "string",
          "description": "Unique lowercase handle.",
          "minLength": 3,
          "maxLength": 24,
          "pattern": "^[a-z0-9_]{3,24}$"
        },
        "display_name": {
          "type": "string",
          "description": "Full display name.",
          "minLength": 2,
          "maxLength": 80
        },
        "avatar_url": {
          "type": "string",
          "description": "Optional public avatar URL or compact compressed WebP data URL.",
          "maxLength": 50000
        },
        "cover_url": {
          "type": "string",
          "description": "Optional compressed WebP cover photo data URL.",
          "maxLength": 165000
        },
        "governorate": {
          "type": "string",
          "description": "Optional governorate name.",
          "maxLength": 80
        },
        "city": {
          "type": "string",
          "description": "Optional city name.",
          "maxLength": 80
        },
        "bio": {
          "type": "string",
          "description": "Short biography.",
          "maxLength": 500
        },
        "experience_level": {
          "type": "string",
          "description": "Self-selected experience level.",
          "enum": ["beginner", "intermediate", "professional", "no_experience"]
        },
        "profile_completed": {
          "type": "boolean",
          "description": "Indicates onboarding completion."
        },
        "skills": {
          "type": "array",
          "description": "Up to 20 selected skills (1-60 chars each)."
        },
        "interests": {
          "type": "array",
          "description": "1 to 20 opportunity interests (1-60 chars each)."
        },
        "has_balance": {
          "type": "boolean",
          "description": "Admin-controlled visibility flag indicating the user has wallet balance or transaction credits."
        },
        "account_type": {
          "type": "string",
          "description": "Account role chosen during signup ('freelancer' or 'client'); legacy profiles without this field default to 'freelancer'.",
          "enum": ["freelancer", "client"]
        },
        "portfolio_url": {
          "type": "string",
          "description": "Optional external HTTP/HTTPS portfolio link.",
          "maxLength": 300
        },
        "projects": {
          "type": "array",
          "description": "Up to 3 showcase projects, each with either a WebP image data URL or a Google Drive video preview link."
        },
        "createdAt": {
          "type": "string",
          "format": "date-time",
          "description": "Server timestamp when created."
        },
        "updatedAt": {
          "type": "string",
          "format": "date-time",
          "description": "Server timestamp when last updated."
        }
      },
      "required": [
        "id",
        "username",
        "display_name",
        "experience_level",
        "profile_completed",
        "skills",
        "interests",
        "has_balance",
        "createdAt",
        "updatedAt"
      ]
    },
    "UsernameReservation": {
      "title": "Username Reservation",
      "description": "Atomic lowercase username reservation document.",
      "type": "object",
      "properties": {
        "userId": {
          "type": "string",
          "description": "Firebase Auth UID of the owner.",
          "minLength": 1,
          "maxLength": 128,
          "pattern": "^[a-zA-Z0-9_\\-]+$"
        },
        "createdAt": {
          "type": "string",
          "format": "date-time",
          "description": "Server timestamp when reserved."
        }
      },
      "required": ["userId", "createdAt"]
    },
    "WalletSettings": {
      "title": "Wallet Pricing Settings",
      "description": "Superuser-controlled pricing per transaction and minimum transaction count.",
      "type": "object",
      "properties": {
        "transaction_price_egp": {
          "type": "integer",
          "description": "Price per transaction in EGP (1-100000)."
        },
        "min_transactions": {
          "type": "integer",
          "description": "Minimum transactions per top-up request (1-1000)."
        },
        "updatedBy": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128,
          "pattern": "^[a-zA-Z0-9_\\-]+$"
        },
        "updatedAt": {
          "type": "string",
          "format": "date-time"
        }
      },
      "required": ["transaction_price_egp", "min_transactions", "updatedBy", "updatedAt"]
    },
    "Wallet": {
      "title": "User Wallet",
      "description": "Admin-managed wallet holding EGP balance and remaining transaction attempts.",
      "type": "object",
      "properties": {
        "userId": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128,
          "pattern": "^[a-zA-Z0-9_\\-]+$"
        },
        "balance_egp": {
          "type": "integer",
          "description": "Available EGP balance credited by admin."
        },
        "remaining_transactions": {
          "type": "integer",
          "description": "Available transaction attempts credited by admin."
        },
        "is_unlocked": {
          "type": "boolean",
          "description": "Whether account features are unlocked."
        },
        "updatedAt": {
          "type": "string",
          "format": "date-time"
        }
      },
      "required": ["userId", "balance_egp", "remaining_transactions", "is_unlocked", "updatedAt"]
    },
    "TopupRequest": {
      "title": "Wallet Top-up Request",
      "description": "Manual top-up request submitted by a user with requested attempts and transfer receipt image.",
      "type": "object",
      "properties": {
        "id": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128,
          "pattern": "^[a-zA-Z0-9_\\-]+$"
        },
        "userId": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128,
          "pattern": "^[a-zA-Z0-9_\\-]+$"
        },
        "userDisplayName": {
          "type": "string",
          "minLength": 2,
          "maxLength": 80
        },
        "username": {
          "type": "string",
          "minLength": 3,
          "maxLength": 24,
          "pattern": "^[a-z0-9_]{3,24}$"
        },
        "userEmail": {
          "type": "string",
          "minLength": 3,
          "maxLength": 160
        },
        "requested_transactions": {
          "type": "integer",
          "description": "Requested number of transactions."
        },
        "calculated_amount_egp": {
          "type": "integer",
          "description": "Calculated EGP amount based on admin-configured transaction price."
        },
        "transfer_reference": {
          "type": "string",
          "maxLength": 120
        },
        "receipt_image_url": {
          "type": "string",
          "minLength": 1,
          "maxLength": 300000
        },
        "status": {
          "type": "string",
          "enum": ["pending", "approved", "rejected"]
        },
        "approved_transactions": {
          "type": "integer"
        },
        "approved_amount_egp": {
          "type": "integer"
        },
        "admin_note": {
          "type": "string",
          "maxLength": 300
        },
        "reviewed_by": {
          "type": "string",
          "maxLength": 128
        },
        "createdAt": {
          "type": "string",
          "format": "date-time"
        },
        "updatedAt": {
          "type": "string",
          "format": "date-time"
        },
        "reviewedAt": {
          "type": "string",
          "format": "date-time"
        }
      },
      "required": [
        "id",
        "userId",
        "userDisplayName",
        "username",
        "userEmail",
        "requested_transactions",
        "calculated_amount_egp",
        "receipt_image_url",
        "status",
        "createdAt",
        "updatedAt"
      ]
    },
    "WalletTransaction": {
      "title": "Wallet Ledger Entry",
      "description": "Append-only wallet credit/debit ledger record.",
      "type": "object",
      "properties": {
        "id": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128,
          "pattern": "^[a-zA-Z0-9_\\-]+$"
        },
        "userId": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128,
          "pattern": "^[a-zA-Z0-9_\\-]+$"
        },
        "type": {
          "type": "string",
          "enum": ["credit", "debit"]
        },
        "title": {
          "type": "string",
          "minLength": 1,
          "maxLength": 120
        },
        "amount_egp": {
          "type": "integer"
        },
        "transactions_delta": {
          "type": "integer"
        },
        "requestId": {
          "type": "string",
          "maxLength": 128
        },
        "createdBy": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128,
          "pattern": "^[a-zA-Z0-9_\\-]+$"
        },
        "createdAt": {
          "type": "string",
          "format": "date-time"
        }
      },
      "required": ["id", "userId", "type", "title", "amount_egp", "transactions_delta", "createdBy", "createdAt"]
    },
    "ConnectionRequest": {
      "title": "Client Connection Request",
      "description": "Contact/hiring request sent by a client or member to a freelancer.",
      "type": "object",
      "properties": {
        "id": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128,
          "pattern": "^[a-zA-Z0-9_\\-]+$"
        },
        "fromUserId": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128,
          "pattern": "^[a-zA-Z0-9_\\-]+$"
        },
        "fromDisplayName": {
          "type": "string",
          "minLength": 2,
          "maxLength": 80
        },
        "fromUsername": {
          "type": "string",
          "minLength": 3,
          "maxLength": 24,
          "pattern": "^[a-z0-9_]{3,24}$"
        },
        "fromAccountType": {
          "type": "string",
          "enum": ["freelancer", "client"]
        },
        "toUserId": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128,
          "pattern": "^[a-zA-Z0-9_\\-]+$"
        },
        "toDisplayName": {
          "type": "string",
          "minLength": 2,
          "maxLength": 80
        },
        "toUsername": {
          "type": "string",
          "minLength": 3,
          "maxLength": 24,
          "pattern": "^[a-z0-9_]{3,24}$"
        },
        "message": {
          "type": "string",
          "maxLength": 500
        },
        "status": {
          "type": "string",
          "enum": ["pending", "accepted", "declined"]
        },
        "createdAt": {
          "type": "string",
          "format": "date-time"
        },
        "updatedAt": {
          "type": "string",
          "format": "date-time"
        },
        "respondedAt": {
          "type": "string",
          "format": "date-time"
        }
      },
      "required": [
        "id",
        "fromUserId",
        "fromDisplayName",
        "fromUsername",
        "fromAccountType",
        "toUserId",
        "toDisplayName",
        "toUsername",
        "message",
        "status",
        "createdAt",
        "updatedAt"
      ]
    },
    "UserNotification": {
      "title": "User Real-time Notification",
      "description": "Private real-time notification targeted at a single user UID.",
      "type": "object",
      "properties": {
        "id": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128,
          "pattern": "^[a-zA-Z0-9_\\-]+$"
        },
        "userId": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128,
          "pattern": "^[a-zA-Z0-9_\\-]+$"
        },
        "actorUserId": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128,
          "pattern": "^[a-zA-Z0-9_\\-]+$"
        },
        "actorDisplayName": {
          "type": "string",
          "minLength": 2,
          "maxLength": 80
        },
        "actorUsername": {
          "type": "string",
          "minLength": 3,
          "maxLength": 24,
          "pattern": "^[a-z0-9_]{3,24}$"
        },
        "actorAccountType": {
          "type": "string",
          "enum": ["freelancer", "client"]
        },
        "type": {
          "type": "string",
          "enum": ["client_request", "request_accepted", "request_declined"]
        },
        "title": {
          "type": "string",
          "minLength": 2,
          "maxLength": 120
        },
        "body": {
          "type": "string",
          "maxLength": 500
        },
        "requestId": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128,
          "pattern": "^[a-zA-Z0-9_\\-]+$"
        },
        "is_read": {
          "type": "boolean"
        },
        "createdAt": {
          "type": "string",
          "format": "date-time"
        }
      },
      "required": [
        "id",
        "userId",
        "actorUserId",
        "actorDisplayName",
        "actorUsername",
        "actorAccountType",
        "type",
        "title",
        "body",
        "requestId",
        "is_read",
        "createdAt"
      ]
    }
  },
  "firestore": {
    "/profiles/{userId}": {
      "schema": { "$ref": "#/entities/Profile" },
      "description": "Completed user profiles keyed by Firebase Auth UID."
    },
    "/usernames/{username}": {
      "schema": { "$ref": "#/entities/UsernameReservation" },
      "description": "Lowercase username reservations enforcing global uniqueness."
    },
    "/app_settings/{settingId}": {
      "schema": { "$ref": "#/entities/WalletSettings" },
      "description": "Global wallet pricing settings managed by superuser admin."
    },
    "/wallets/{userId}": {
      "schema": { "$ref": "#/entities/Wallet" },
      "description": "Admin-managed wallet balances and unlocked transaction counts."
    },
    "/topup_requests/{requestId}": {
      "schema": { "$ref": "#/entities/TopupRequest" },
      "description": "User-submitted wallet top-up requests with transfer receipt images."
    },
    "/wallet_transactions/{txId}": {
      "schema": { "$ref": "#/entities/WalletTransaction" },
      "description": "Append-only wallet ledger entries created by superuser admin."
    },
    "/connection_requests/{requestId}": {
      "schema": { "$ref": "#/entities/ConnectionRequest" },
      "description": "Client-to-freelancer contact requests with atomic notification creation and status replies."
    },
    "/notifications/{notifId}": {
      "schema": { "$ref": "#/entities/UserNotification" },
      "description": "Private real-time notifications scoped strictly to the target recipient."
    }
  }
}
