rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Global safety net: deny all reads and writes unless explicitly matched
    match /{document=**} {
      allow read, write: if false;
    }

    function isValidId(id) {
      return id is string && id.size() >= 1 && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$');
    }

    function isValidUsername(name) {
      return name is string && name.size() >= 3 && name.size() <= 24 && name.matches('^[a-z0-9_]{3,24}$');
    }

    function incoming() {
      return request.resource.data;
    }

    function existing() {
      return resource.data;
    }

    function isSignedIn() {
      return request.auth != null;
    }

    function isVerifiedUser() {
      return isSignedIn() && request.auth.token.email_verified == true;
    }

    function isOwner(userId) {
      return isSignedIn() && request.auth.uid == userId;
    }

    function isAdmin() {
      return isVerifiedUser() && (
        request.auth.token.email == 'saadelsafel@gmail.com' ||
        exists(/databases/$(database)/documents/admins/$(request.auth.uid))
      );
    }

    function isValidProject(proj) {
      return proj is map
        && proj.keys().hasAll(['id', 'title'])
        && proj.keys().hasOnly(['id', 'title', 'description', 'image_url', 'video_drive_url'])
        && proj.id is string
        && isValidId(proj.id)
        && proj.title is string
        && proj.title.size() >= 2
        && proj.title.size() <= 80
        && (!('description' in proj) || proj.description == null || (proj.description is string && proj.description.size() <= 300))
        && (!('image_url' in proj) || proj.image_url == null || (proj.image_url is string && proj.image_url.size() <= 180000 && proj.image_url.matches('^data:image/webp;base64,[A-Za-z0-9+/=]+$')))
        && (!('video_drive_url' in proj) || proj.video_drive_url == null || (proj.video_drive_url is string && proj.video_drive_url.size() <= 300 && proj.video_drive_url.matches('^https://drive\\.google\\.com/file/d/[a-zA-Z0-9_\\-]+/preview$')))
        && (
          (('image_url' in proj && proj.image_url != null) && (!('video_drive_url' in proj) || proj.video_drive_url == null))
          || (('video_drive_url' in proj && proj.video_drive_url != null) && (!('image_url' in proj) || proj.image_url == null))
        );
    }

    function isValidProfile(data, userId) {
      return data.keys().hasAll([
          'id',
          'username',
          'display_name',
          'experience_level',
          'profile_completed',
          'skills',
          'interests',
          'createdAt',
          'updatedAt'
        ])
        && data.keys().hasOnly([
          'id',
          'username',
          'display_name',
          'avatar_url',
          'cover_url',
          'governorate',
          'city',
          'bio',
          'portfolio_url',
          'projects',
          'experience_level',
          'profile_completed',
          'skills',
          'interests',
          'has_balance',
          'wallet_priority',
          'review_score',
          'review_count',
          'account_type',
          'createdAt',
          'updatedAt'
        ])
        && data.id is string
        && isValidId(data.id)
        && data.id == userId
        && isValidUsername(data.username)
        && data.display_name is string
        && data.display_name.size() >= 2
        && data.display_name.size() <= 80
        && (!('avatar_url' in data) || data.avatar_url == null || (data.avatar_url is string && data.avatar_url.size() <= 50000))
        && (!('cover_url' in data) || data.cover_url == null || (data.cover_url is string && data.cover_url.size() <= 165000 && data.cover_url.matches('^data:image/webp;base64,[A-Za-z0-9+/=]+$')))
        && (!('governorate' in data) || data.governorate == null || (data.governorate is string && data.governorate.size() <= 80))
        && (!('city' in data) || data.city == null || (data.city is string && data.city.size() <= 80))
        && (!('bio' in data) || data.bio == null || (data.bio is string && data.bio.size() <= 500))
        && (!('portfolio_url' in data) || data.portfolio_url == null || (data.portfolio_url is string && data.portfolio_url.size() <= 300 && data.portfolio_url.matches('^https?://[^\\s<>"]+$')))
        && (!('projects' in data) || (
          data.projects is list
          && data.projects.size() <= 3
          && (data.projects.size() < 1 || isValidProject(data.projects[0]))
          && (data.projects.size() < 2 || isValidProject(data.projects[1]))
          && (data.projects.size() < 3 || isValidProject(data.projects[2]))
        ))
        && data.experience_level is string
        && data.experience_level in ['beginner', 'intermediate', 'professional', 'no_experience']
        && data.profile_completed is bool
        && data.profile_completed == true
        && data.skills is list
        && data.skills.size() <= 20
        && (data.skills.size() == 0 || (data.skills[0] is string && data.skills[0].size() >= 1 && data.skills[0].size() <= 60))
        && data.interests is list
        && data.interests.size() >= 1
        && data.interests.size() <= 20
        && data.interests[0] is string
        && data.interests[0].size() >= 1
        && data.interests[0].size() <= 60
        && (!('has_balance' in data) || data.has_balance is bool)
        && (!('wallet_priority' in data) || (data.wallet_priority is int && data.wallet_priority >= 0 && data.wallet_priority <= 1000000100))
        && (!('review_score' in data) || (data.review_score is number && data.review_score >= 0 && data.review_score <= 5))
        && (!('review_count' in data) || (data.review_count is int && data.review_count >= 0 && data.review_count <= 1000000))
        && (!('account_type' in data) || (data.account_type is string && data.account_type in ['freelancer', 'client']))
        && data.createdAt is timestamp
        && data.updatedAt is timestamp;
    }

    function isValidAdminProfileSync(data, prev, userId) {
      return isValidId(userId)
        && data.updatedAt is timestamp
        && data.updatedAt == request.time
        && data.diff(prev).affectedKeys().hasOnly([
          'has_balance',
          'wallet_priority',
          'review_score',
          'review_count',
          'account_type',
          'updatedAt'
        ])
        && (!('has_balance' in data) || data.has_balance is bool)
        && (!('has_balance' in data) || data.has_balance == false || !('account_type' in data) || data.account_type != 'client')
        && (!('wallet_priority' in data) || (data.wallet_priority is int && data.wallet_priority >= 0 && data.wallet_priority <= 1000000100))
        && (!('review_score' in data) || (data.review_score is number && data.review_score >= 0 && data.review_score <= 5))
        && (!('review_count' in data) || (data.review_count is int && data.review_count >= 0 && data.review_count <= 1000000))
        && (
          !data.diff(prev).affectedKeys().hasAny(['account_type'])
          || ((!('account_type' in prev) || prev.account_type == null || prev.account_type == '') && data.account_type == 'freelancer')
        );
    }

    function isValidUsernameReservation(data) {
      return data.keys().hasAll(['userId', 'createdAt'])
        && data.keys().hasOnly(['userId', 'createdAt'])
        && data.userId is string
        && isValidId(data.userId)
        && data.userId == request.auth.uid
        && data.createdAt is timestamp;
    }

    function isValidWalletSettings(data) {
      return data.keys().hasAll(['transaction_price_egp', 'min_transactions', 'updatedBy', 'updatedAt'])
        && data.keys().hasOnly(['transaction_price_egp', 'min_transactions', 'updatedBy', 'updatedAt'])
        && data.transaction_price_egp is int
        && data.transaction_price_egp >= 1
        && data.transaction_price_egp <= 100000
        && data.min_transactions is int
        && data.min_transactions >= 1
        && data.min_transactions <= 1000
        && data.updatedBy is string
        && isValidId(data.updatedBy)
        && data.updatedBy == request.auth.uid
        && data.updatedAt is timestamp;
    }

    function isValidWallet(data, userId) {
      return data.keys().hasAll(['userId', 'balance_egp', 'remaining_transactions', 'is_unlocked', 'updatedAt'])
        && data.keys().hasOnly(['userId', 'balance_egp', 'remaining_transactions', 'is_unlocked', 'updatedAt'])
        && data.userId is string
        && isValidId(data.userId)
        && data.userId == userId
        && data.balance_egp is int
        && data.balance_egp >= 0
        && data.balance_egp <= 10000000
        && data.remaining_transactions is int
        && data.remaining_transactions >= 0
        && data.remaining_transactions <= 100000
        && data.is_unlocked is bool
        && data.updatedAt is timestamp;
    }

    function matchesConfiguredTopupPricing(data) {
      return exists(/databases/$(database)/documents/app_settings/wallet)
        ? (
          data.requested_transactions >= get(/databases/$(database)/documents/app_settings/wallet).data.min_transactions
          && data.calculated_amount_egp == data.requested_transactions * get(/databases/$(database)/documents/app_settings/wallet).data.transaction_price_egp
        )
        : (
          data.requested_transactions >= 5
          && data.calculated_amount_egp == data.requested_transactions * 20
        );
    }

    function isValidTopupRequestCreate(data, requestId) {
      return data.keys().hasAll([
          'id',
          'userId',
          'userDisplayName',
          'username',
          'userEmail',
          'requested_transactions',
          'calculated_amount_egp',
          'receipt_image_url',
          'status',
          'createdAt',
          'updatedAt'
        ])
        && data.keys().hasOnly([
          'id',
          'userId',
          'userDisplayName',
          'username',
          'userEmail',
          'requested_transactions',
          'calculated_amount_egp',
          'transfer_reference',
          'receipt_image_url',
          'status',
          'approved_transactions',
          'approved_amount_egp',
          'admin_note',
          'reviewed_by',
          'createdAt',
          'updatedAt',
          'reviewedAt'
        ])
        && data.id is string
        && isValidId(data.id)
        && data.id == requestId
        && data.userId is string
        && isValidId(data.userId)
        && data.userDisplayName is string
        && data.userDisplayName.size() >= 2
        && data.userDisplayName.size() <= 80
        && isValidUsername(data.username)
        && data.userEmail is string
        && data.userEmail.size() >= 3
        && data.userEmail.size() <= 160
        && data.requested_transactions is int
        && data.requested_transactions >= 1
        && data.requested_transactions <= 1000
        && data.calculated_amount_egp is int
        && data.calculated_amount_egp >= 1
        && data.calculated_amount_egp <= 100000000
        && (!('transfer_reference' in data) || data.transfer_reference == null || (data.transfer_reference is string && data.transfer_reference.size() <= 120))
        && data.receipt_image_url is string
        && data.receipt_image_url.size() >= 1
        && data.receipt_image_url.size() <= 300000
        && data.status is string
        && data.status == 'pending'
        && (!('approved_transactions' in data) || data.approved_transactions == null)
        && (!('approved_amount_egp' in data) || data.approved_amount_egp == null)
        && (!('admin_note' in data) || data.admin_note == null)
        && (!('reviewed_by' in data) || data.reviewed_by == null)
        && (!('reviewedAt' in data) || data.reviewedAt == null)
        && data.createdAt is timestamp
        && data.updatedAt is timestamp;
    }

    function isValidTopupRequestUpdate(data, prev, requestId) {
      return data.keys().hasAll([
          'id',
          'userId',
          'userDisplayName',
          'username',
          'userEmail',
          'requested_transactions',
          'calculated_amount_egp',
          'receipt_image_url',
          'status',
          'createdAt',
          'updatedAt',
          'reviewedAt'
        ])
        && data.keys().hasOnly([
          'id',
          'userId',
          'userDisplayName',
          'username',
          'userEmail',
          'requested_transactions',
          'calculated_amount_egp',
          'transfer_reference',
          'receipt_image_url',
          'status',
          'approved_transactions',
          'approved_amount_egp',
          'admin_note',
          'reviewed_by',
          'createdAt',
          'updatedAt',
          'reviewedAt'
        ])
        && data.id == requestId
        && data.id == prev.id
        && data.userId == prev.userId
        && data.createdAt == prev.createdAt
        && data.status is string
        && data.status in ['approved', 'rejected']
        && (!('approved_transactions' in data) || data.approved_transactions == null || (data.approved_transactions is int && data.approved_transactions >= 0 && data.approved_transactions <= 100000))
        && (!('approved_amount_egp' in data) || data.approved_amount_egp == null || (data.approved_amount_egp is int && data.approved_amount_egp >= 0 && data.approved_amount_egp <= 10000000))
        && (!('admin_note' in data) || data.admin_note == null || (data.admin_note is string && data.admin_note.size() <= 300))
        && data.reviewed_by is string
        && data.reviewed_by == request.auth.uid
        && data.updatedAt is timestamp
        && data.reviewedAt is timestamp;
    }

    function isValidWalletTransaction(data, txId) {
      return data.keys().hasAll(['id', 'userId', 'type', 'title', 'amount_egp', 'transactions_delta', 'createdBy', 'createdAt'])
        && data.keys().hasOnly(['id', 'userId', 'type', 'title', 'amount_egp', 'transactions_delta', 'requestId', 'createdBy', 'createdAt'])
        && data.id is string
        && isValidId(data.id)
        && data.id == txId
        && data.userId is string
        && isValidId(data.userId)
        && data.type is string
        && data.type in ['credit', 'debit']
        && data.title is string
        && data.title.size() >= 1
        && data.title.size() <= 120
        && data.amount_egp is int
        && data.amount_egp >= 0
        && data.amount_egp <= 10000000
        && data.transactions_delta is int
        && data.transactions_delta >= -100000
        && data.transactions_delta <= 100000
        && (!('requestId' in data) || data.requestId == null || (data.requestId is string && isValidId(data.requestId)))
        && data.createdBy is string
        && isValidId(data.createdBy)
        && data.createdBy == request.auth.uid
        && data.createdAt is timestamp;
    }

    function isValidConnectionRequestCreate(data, requestId) {
      return data.keys().hasAll([
          'id',
          'fromUserId',
          'fromDisplayName',
          'fromUsername',
          'fromAccountType',
          'toUserId',
          'toDisplayName',
          'toUsername',
          'message',
          'status',
          'createdAt',
          'updatedAt'
        ])
        && data.keys().hasOnly([
          'id',
          'fromUserId',
          'fromDisplayName',
          'fromUsername',
          'fromAccountType',
          'toUserId',
          'toDisplayName',
          'toUsername',
          'message',
          'status',
          'createdAt',
          'updatedAt',
          'respondedAt'
        ])
        && data.id is string
        && isValidId(data.id)
        && data.id == requestId
        && data.fromUserId is string
        && isValidId(data.fromUserId)
        && data.fromUserId == request.auth.uid
        && data.fromDisplayName is string
        && data.fromDisplayName.size() >= 2
        && data.fromDisplayName.size() <= 80
        && isValidUsername(data.fromUsername)
        && data.fromAccountType is string
        && data.fromAccountType in ['freelancer', 'client']
        && data.toUserId is string
        && isValidId(data.toUserId)
        && data.toUserId != request.auth.uid
        && data.toDisplayName is string
        && data.toDisplayName.size() >= 2
        && data.toDisplayName.size() <= 80
        && isValidUsername(data.toUsername)
        && data.message is string
        && data.message.size() <= 500
        && data.status is string
        && data.status == 'pending'
        && (!('respondedAt' in data) || data.respondedAt == null)
        && data.createdAt is timestamp
        && data.updatedAt is timestamp;
    }

    function isValidNotificationCreate(data, notifId) {
      return data.keys().hasAll([
          'id',
          'userId',
          'actorUserId',
          'actorDisplayName',
          'actorUsername',
          'actorAccountType',
          'type',
          'title',
          'body',
          'requestId',
          'is_read',
          'createdAt'
        ])
        && data.keys().hasOnly([
          'id',
          'userId',
          'actorUserId',
          'actorDisplayName',
          'actorUsername',
          'actorAccountType',
          'type',
          'title',
          'body',
          'requestId',
          'is_read',
          'createdAt'
        ])
        && data.id is string
        && isValidId(data.id)
        && data.id == notifId
        && data.userId is string
        && isValidId(data.userId)
        && data.userId != request.auth.uid
        && data.actorUserId is string
        && isValidId(data.actorUserId)
        && data.actorUserId == request.auth.uid
        && data.actorDisplayName is string
        && data.actorDisplayName.size() >= 2
        && data.actorDisplayName.size() <= 80
        && isValidUsername(data.actorUsername)
        && data.actorAccountType is string
        && data.actorAccountType in ['freelancer', 'client']
        && data.type is string
        && data.type in ['client_request', 'request_accepted', 'request_declined']
        && data.title is string
        && data.title.size() >= 2
        && data.title.size() <= 120
        && data.body is string
        && data.body.size() <= 500
        && data.requestId is string
        && isValidId(data.requestId)
        && data.is_read is bool
        && data.is_read == false
        && data.createdAt is timestamp;
    }

    match /profiles/{userId} {
      allow get: if isSignedIn() && isValidId(userId) && (
        isOwner(userId)
        || isAdmin()
        || (existing().has_balance == true && (!('account_type' in existing()) || existing().account_type == 'freelancer'))
      );
      allow list: if isSignedIn() && (isAdmin() || resource.data.has_balance == true);
      allow create: if isVerifiedUser()
        && isValidId(userId)
        && isOwner(userId)
        && isValidProfile(incoming(), userId)
        && ('has_balance' in incoming())
        && incoming().has_balance == false
        && ('account_type' in incoming())
        && incoming().account_type in ['freelancer', 'client']
        && incoming().createdAt == request.time
        && incoming().updatedAt == request.time
        && existsAfter(/databases/$(database)/documents/usernames/$(incoming().username))
        && getAfter(/databases/$(database)/documents/usernames/$(incoming().username)).data.userId == userId;
      allow update: if isVerifiedUser()
        && isValidId(userId)
        && (
          (
            isAdmin()
            && isValidAdminProfileSync(incoming(), existing(), userId)
          )
          || (
            isValidProfile(incoming(), userId)
            && incoming().id == existing().id
            && incoming().createdAt == existing().createdAt
            && incoming().updatedAt == request.time
            && (
              (
                isOwner(userId)
                && incoming().diff(existing()).affectedKeys().hasOnly([
                  'display_name',
                  'avatar_url',
                  'cover_url',
                  'governorate',
                  'city',
                  'bio',
                  'portfolio_url',
                  'projects',
                  'experience_level',
                  'skills',
                  'interests',
                  'updatedAt'
                ])
              )
              || (
                isOwner(userId)
                && incoming().diff(existing()).affectedKeys().hasOnly([
                  'username',
                  'display_name',
                  'avatar_url',
                  'cover_url',
                  'governorate',
                  'city',
                  'bio',
                  'portfolio_url',
                  'projects',
                  'experience_level',
                  'skills',
                  'interests',
                  'updatedAt'
                ])
                && existsAfter(/databases/$(database)/documents/usernames/$(incoming().username))
                && getAfter(/databases/$(database)/documents/usernames/$(incoming().username)).data.userId == userId
              )
              || (
                isOwner(userId)
                && (!('profile_completed' in existing()) || existing().profile_completed == false)
                && incoming().profile_completed == true
                && (
                  !('account_type' in existing())
                  || incoming().account_type == existing().account_type
                )
                && incoming().diff(existing()).affectedKeys().hasOnly([
                  'username',
                  'display_name',
                  'avatar_url',
                  'cover_url',
                  'governorate',
                  'city',
                  'bio',
                  'portfolio_url',
                  'projects',
                  'experience_level',
                  'profile_completed',
                  'skills',
                  'interests',
                  'account_type',
                  'updatedAt'
                ])
                && existsAfter(/databases/$(database)/documents/usernames/$(incoming().username))
                && getAfter(/databases/$(database)/documents/usernames/$(incoming().username)).data.userId == userId
              )
              || (
                isOwner(userId)
                && (!('account_type' in existing()) || existing().account_type == null || existing().account_type == '')
                && incoming().diff(existing()).affectedKeys().hasOnly([
                  'account_type',
                  'updatedAt'
                ])
                && incoming().account_type == 'freelancer'
              )
            )
          )
        );
      allow delete: if false;
    }

    match /usernames/{username} {
      allow get: if isSignedIn() && isValidUsername(username);
      allow list: if false;
      allow create: if isVerifiedUser()
        && isValidUsername(username)
        && isValidUsernameReservation(incoming())
        && incoming().createdAt == request.time
        && !exists(/databases/$(database)/documents/usernames/$(username))
        && existsAfter(/databases/$(database)/documents/profiles/$(request.auth.uid))
        && getAfter(/databases/$(database)/documents/profiles/$(request.auth.uid)).data.username == username;
      allow update: if false;
      allow delete: if isVerifiedUser()
        && isValidUsername(username)
        && resource != null
        && existing().userId == request.auth.uid
        && (!existsAfter(/databases/$(database)/documents/profiles/$(request.auth.uid))
          || getAfter(/databases/$(database)/documents/profiles/$(request.auth.uid)).data.username != username);
    }

    match /app_settings/{settingId} {
      allow get: if isSignedIn() && isValidId(settingId) && settingId == 'wallet';
      allow list: if false;
      allow create: if isAdmin()
        && isValidId(settingId)
        && settingId == 'wallet'
        && isValidWalletSettings(incoming())
        && incoming().updatedAt == request.time;
      allow update: if isAdmin()
        && isValidId(settingId)
        && settingId == 'wallet'
        && isValidWalletSettings(incoming())
        && incoming().updatedAt == request.time
        && incoming().diff(existing()).affectedKeys().hasOnly([
          'transaction_price_egp',
          'min_transactions',
          'updatedBy',
          'updatedAt'
        ]);
      allow delete: if false;
    }

    match /wallets/{userId} {
      allow get: if isSignedIn() && isValidId(userId) && (isOwner(userId) || isAdmin());
      allow list: if isAdmin();
      allow create: if isAdmin()
        && isValidId(userId)
        && isValidWallet(incoming(), userId)
        && incoming().updatedAt == request.time;
      allow update: if isAdmin()
        && isValidId(userId)
        && isValidWallet(incoming(), userId)
        && incoming().userId == existing().userId
        && incoming().updatedAt == request.time
        && incoming().diff(existing()).affectedKeys().hasOnly([
          'balance_egp',
          'remaining_transactions',
          'is_unlocked',
          'updatedAt'
        ]);
      allow delete: if false;
    }

    match /topup_requests/{requestId} {
      allow get: if isSignedIn() && isValidId(requestId) && (existing().userId == request.auth.uid || isAdmin());
      allow list: if isSignedIn() && (isAdmin() || resource.data.userId == request.auth.uid);
      allow create: if isVerifiedUser()
        && isValidId(requestId)
        && isValidTopupRequestCreate(incoming(), requestId)
        && incoming().userId == request.auth.uid
        && incoming().createdAt == request.time
        && incoming().updatedAt == request.time
        && matchesConfiguredTopupPricing(incoming());
      allow update: if isAdmin()
        && isValidId(requestId)
        && existing().status == 'pending'
        && isValidTopupRequestUpdate(incoming(), existing(), requestId)
        && incoming().updatedAt == request.time
        && incoming().reviewedAt == request.time
        && incoming().diff(existing()).affectedKeys().hasOnly([
          'status',
          'approved_transactions',
          'approved_amount_egp',
          'admin_note',
          'reviewed_by',
          'updatedAt',
          'reviewedAt'
        ])
        && (
          incoming().status == 'rejected'
          || (
            incoming().status == 'approved'
            && incoming().approved_transactions is int
            && incoming().approved_transactions >= 1
            && incoming().approved_amount_egp is int
            && incoming().approved_amount_egp >= 0
            && existsAfter(/databases/$(database)/documents/wallets/$(existing().userId))
          )
        );
      allow delete: if false;
    }

    match /wallet_transactions/{txId} {
      allow get: if isSignedIn() && isValidId(txId) && (existing().userId == request.auth.uid || isAdmin());
      allow list: if isSignedIn() && (isAdmin() || resource.data.userId == request.auth.uid);
      allow create: if isAdmin()
        && isValidId(txId)
        && isValidWalletTransaction(incoming(), txId)
        && incoming().createdAt == request.time;
      allow update: if false;
      allow delete: if false;
    }

    match /connection_requests/{requestId} {
      allow get: if isSignedIn() && isValidId(requestId) && (
        existing().fromUserId == request.auth.uid
        || existing().toUserId == request.auth.uid
        || isAdmin()
      );
      allow list: if isSignedIn() && (
        isAdmin()
        || resource.data.fromUserId == request.auth.uid
        || resource.data.toUserId == request.auth.uid
      );
      allow create: if isVerifiedUser()
        && isValidId(requestId)
        && isValidConnectionRequestCreate(incoming(), requestId)
        && incoming().createdAt == request.time
        && incoming().updatedAt == request.time
        && exists(/databases/$(database)/documents/profiles/$(incoming().toUserId))
        && (!('account_type' in get(/databases/$(database)/documents/profiles/$(incoming().toUserId)).data)
          || get(/databases/$(database)/documents/profiles/$(incoming().toUserId)).data.account_type == 'freelancer')
        && (get(/databases/$(database)/documents/profiles/$(incoming().toUserId)).data.has_balance == true || isAdmin())
        && existsAfter(/databases/$(database)/documents/notifications/$(requestId))
        && getAfter(/databases/$(database)/documents/notifications/$(requestId)).data.requestId == requestId
        && getAfter(/databases/$(database)/documents/notifications/$(requestId)).data.userId == incoming().toUserId
        && getAfter(/databases/$(database)/documents/notifications/$(requestId)).data.actorUserId == request.auth.uid
        && getAfter(/databases/$(database)/documents/notifications/$(requestId)).data.type == 'client_request';
      allow update: if isVerifiedUser()
        && isValidId(requestId)
        && existing().toUserId == request.auth.uid
        && existing().status == 'pending'
        && incoming().diff(existing()).affectedKeys().hasOnly(['status', 'updatedAt', 'respondedAt'])
        && incoming().status is string
        && incoming().status in ['accepted', 'declined']
        && incoming().updatedAt == request.time
        && incoming().respondedAt == request.time
        && existsAfter(/databases/$(database)/documents/notifications/$(requestId + '_reply'))
        && getAfter(/databases/$(database)/documents/notifications/$(requestId + '_reply')).data.requestId == requestId
        && getAfter(/databases/$(database)/documents/notifications/$(requestId + '_reply')).data.userId == existing().fromUserId
        && getAfter(/databases/$(database)/documents/notifications/$(requestId + '_reply')).data.actorUserId == request.auth.uid;
      allow delete: if false;
    }

    match /notifications/{notifId} {
      allow get: if isSignedIn() && isValidId(notifId) && (
        existing().userId == request.auth.uid
        || isAdmin()
      );
      allow list: if isSignedIn() && (
        isAdmin()
        || resource.data.userId == request.auth.uid
      );
      allow create: if isVerifiedUser()
        && isValidId(notifId)
        && isValidNotificationCreate(incoming(), notifId)
        && incoming().createdAt == request.time
        && (
          (
            incoming().type == 'client_request'
            && notifId == incoming().requestId
            && existsAfter(/databases/$(database)/documents/connection_requests/$(incoming().requestId))
            && getAfter(/databases/$(database)/documents/connection_requests/$(incoming().requestId)).data.fromUserId == request.auth.uid
            && getAfter(/databases/$(database)/documents/connection_requests/$(incoming().requestId)).data.toUserId == incoming().userId
          )
          || (
            incoming().type in ['request_accepted', 'request_declined']
            && notifId == incoming().requestId + '_reply'
            && exists(/databases/$(database)/documents/connection_requests/$(incoming().requestId))
            && get(/databases/$(database)/documents/connection_requests/$(incoming().requestId)).data.toUserId == request.auth.uid
            && get(/databases/$(database)/documents/connection_requests/$(incoming().requestId)).data.fromUserId == incoming().userId
            && existsAfter(/databases/$(database)/documents/connection_requests/$(incoming().requestId))
            && (
              (incoming().type == 'request_accepted'
                && getAfter(/databases/$(database)/documents/connection_requests/$(incoming().requestId)).data.status == 'accepted')
              || (incoming().type == 'request_declined'
                && getAfter(/databases/$(database)/documents/connection_requests/$(incoming().requestId)).data.status == 'declined')
            )
          )
        );
      allow update: if isVerifiedUser()
        && isValidId(notifId)
        && existing().userId == request.auth.uid
        && incoming().diff(existing()).affectedKeys().hasOnly(['is_read'])
        && incoming().is_read is bool
        && incoming().is_read == true;
      allow delete: if false;
    }
  }
}
